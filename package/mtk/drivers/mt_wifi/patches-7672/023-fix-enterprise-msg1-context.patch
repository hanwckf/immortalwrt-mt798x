--- a/mt_wifi/embedded/security/cmm_wpa.c
+++ b/mt_wifi/embedded/security/cmm_wpa.c
@@ -5109,13 +5109,25 @@ VOID WPABuildPairMsg1(
 	PHANDSHAKE_PROFILE pHandshake4Way  = NULL;
 	UINT GroupMsg1Len = 0;
 
+	/*
+	 * Message 1 is only valid after a complete station security context is
+	 * available.  In particular, WPA-Enterprise obtains its PMK from 8021xd;
+	 * never dereference an incomplete entry while emitting diagnostic output.
+	 */
+	if (!pAd || !pSecConfig || !pEntry || !pEntry->wdev) {
+		if (pAd)
+			MTWF_DBG(pAd, DBG_CAT_SEC, DBG_SUBCAT_ALL, DBG_LVL_ERROR,
+				"[ERROR] : invalid Msg1 security context.\n");
+		return;
+	}
+
 
 	if (RTMP_TEST_FLAG(pAd, fRTMP_ADAPTER_HALT_IN_PROGRESS)) {
 		MTWF_DBG(pAd, DBG_CAT_SEC, DBG_SUBCAT_ALL, DBG_LVL_ERROR, "[ERROR] : The interface is closed...\n");
 		return;
 	}
 
-	if ((!pEntry) || IS_ENTRY_NONE(pEntry)) {
+	if (IS_ENTRY_NONE(pEntry)) {
 		MTWF_DBG(pAd, DBG_CAT_SEC, DBG_SUBCAT_ALL, DBG_LVL_ERROR, "[ERROR] : The entry doesn't exist.\n");
 		return;
 	}
