@@ -7397,17 +7397,21 @@ static VOID WpaEAPOLStartAction(

 	if ((tr_entry->PortSecured == WPA_802_1X_PORT_NOT_SECURED)
 		&& (pSecConfig->Handshake.WpaState < AS_PTKSTART)
+#ifdef DOT1X_SUPPORT
+		/* Enterprise obtains its PMK asynchronously from 8021xd. */
