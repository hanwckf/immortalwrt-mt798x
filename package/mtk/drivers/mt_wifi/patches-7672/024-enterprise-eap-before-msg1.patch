-		MTWF_DBG(pAd, DBG_CAT_SEC, DBG_SUBCAT_ALL, DBG_LVL_ERROR, ("Enqueue EAPoL-Start-1X for sta("MACSTR")\n", MAC2STR(pEntry->Addr)));
+		MTWF_DBG(pAd, DBG_CAT_SEC, DBG_SUBCAT_ALL, DBG_LVL_ERROR, "Enqueue EAPoL-Start-1X for sta("MACSTR")\n", MAC2STR(pEntry->Addr));
 		DOT1X_EapTriggerAction(pAd, pEntry);
 	}
